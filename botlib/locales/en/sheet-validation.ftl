# Sheet data-validation dialog
sheet-dv-whole = Whole number
sheet-dv-decimal = Decimal
sheet-dv-list = List
sheet-dv-any = Any value
sheet-dv-between = Between
sheet-dv-gte = Greater than or equal
sheet-dv-lte = Less than or equal
sheet-dv-gt = Greater than
sheet-dv-lt = Less than
sheet-dv-eq = Equal to
sheet-dv-neq = Not equal to
sheet-dv-range = Cell range (e.g. A1:C10)
sheet-dv-operator = Operator
sheet-dv-value = Value
sheet-dv-value2 = Second value (for Between)
sheet-dv-error = Error message

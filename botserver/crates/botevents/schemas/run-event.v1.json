        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "child_run_id",
              "agent_name"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUBAGENT_FINISHED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "child_run_id",
              "state"
            ]
          }
        }
      }
    }

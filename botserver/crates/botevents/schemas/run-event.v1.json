      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "activity_id",
              "activity_type"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ACTIVITY_DELTA"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "activity_id",
              "patch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CUSTOM"
          }

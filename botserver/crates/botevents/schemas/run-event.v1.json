{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://general bots/events/run-event.v1.json",
  "title": "General Bots run event",
  "description": "One AG-UI compatible frame in a conversation thread. Sequence numbers are dense and gapless per thread.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "thread_id",
    "run_id",
    "seq",
    "event_id",
    "ts",
    "source",
    "data"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "RUN_ERROR",
        "STEP_STARTED",
        "STEP_FINISHED",
        "TOOL_CALL_START",
        "TOOL_CALL_ARGS",
        "TOOL_CALL_END",
        "TOOL_CALL_RESULT",
        "TEXT_MESSAGE_START",
        "TEXT_MESSAGE_CONTENT",
        "TEXT_MESSAGE_END",
        "STATE_SNAPSHOT",
        "STATE_DELTA",
        "MESSAGES_SNAPSHOT",
        "ACTIVITY_SNAPSHOT",
        "ACTIVITY_DELTA",
        "CUSTOM",
        "RAW",
        "SUBAGENT_STARTED",
        "SUBAGENT_FINISHED"
      ]
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "parent_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "runtime",
        "model",
        "tool",
        "app",
        "user",
        "system",
        "channel"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "RUN_ERROR"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "message"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STEP_STARTED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "step_id",
              "name"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STEP_FINISHED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "step_id",
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TOOL_CALL_START"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "call_id",
              "name"
            ]
          }

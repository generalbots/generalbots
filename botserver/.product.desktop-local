# Product Configuration — Desktop Local Edition
# This file is loaded instead of .product when botserver is compiled
# with --features desktop-local.
#
# #1811 — the desktop bundle embeds every application. This file is the only
# always/preview/hidden split; it never decides what is compiled.

name=General Bots

# Always visible: the desktop essentials. Core surfaces (about, admin,
# settings, auth) are always available without being listed here.
apps=chat,drive,clock-widget,jukebox,sheet,player,calculator,notes,photos,timer,weather,integrations

# Preview applications: revealed only while Preview mode is on. Every registry
# app is classified exactly once across apps/preview_apps/hidden_apps.
preview_apps=analytics,attendant,automations,banking,billing,browser,calendar,campaigns,canvas,compliance,concierge,crm,database,designer,desktop,docs,editor,fraud,goals,handoff,hr,kyc,learn,lists,mail,meet,memory,minutes,monitoring,o365,paper,people,plan,plugins,pos,products,project,recycle,retail,slides,social,store,tasks,tax,templates,terminal,tickets,timeclock,vibe,video,vision,workspace

# Hidden: compiled and routed, but never advertised and refused by the suite
# shell. Research stays out of the desktop product (#1626); `sources` is the
# matching non-app Data Sources surface.
hidden_apps=research,sources

# Chat opens automatically when the suite loads.
suite_default_app=chat

# Sidebar visible so conversation history is reachable (single-user mode).
sidebar=true

# Search enabled: #1632 item 2 restores the taskbar search box and tray.
search_enabled=true

# Menu launcher enabled so the user can switch between Chat and Drive.
menu_launcher_enabled=true

# Authentication is required: the wizard administrator signs in through
# /api/auth/login and keeps a real suite session (the agent VM is only
# provisioned for a logged-in account).
no_security=false

# Shell mode (#1852): the desktop app and the General Bots OS kiosk image use
# this product file. Settings then exposes the low-level "Operating System"
# panel, and /api/system/os serves host data only in this mode.
shell_mode=true

# Shared links (#1863): leave empty to compose path-relative links that only
# work on this machine. Set a public origin to hand out absolute links that
# anyone who can reach the domain may download:
# public_base_url=https://files.example.com

# Default theme
theme=sentient

# #1889 — explicit deployment edition (cloud | desktop | os).
edition=os

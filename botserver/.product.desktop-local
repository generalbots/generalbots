# Product Configuration — Desktop Local Edition (Chat + Drive)
# This file is loaded instead of .product when botserver is compiled
# with --features desktop-local.

name=General Bots

# Only Chat and Drive are active in the desktop-local edition.
apps=chat,drive

# #1614/#1615 — surfaces that stay compiled and routed but are never advertised
# in this profile. Integrations owns the Data Sources tab, so hiding the app
# hides that tab too; direct navigation is refused by the suite shell. Research
# (and its Data Sources surface) is not part of the chat+drive edition either,
# so it is denied explicitly instead of relying on the product app list alone.
hidden_apps=integrations,automations,research,sources

# No preview apps in the local edition.
preview_apps=

# Chat opens automatically when the suite loads.
suite_default_app=chat

# Sidebar visible so conversation history is reachable (single-user mode).
sidebar=true

# Search disabled (no omnibox in local mode).
search_enabled=false

# Menu launcher enabled so the user can switch between Chat and Drive.
menu_launcher_enabled=true

# Authentication is required: the wizard administrator signs in through
# /api/auth/login and keeps a real suite session (the agent VM is only
# provisioned for a logged-in account).
no_security=false

# Default theme
theme=sentient

# Product Configuration File
# This file defines white-label settings for the application.
#
# All occurrences of "General Bots" will be replaced by the 'name' value.
# Only apps listed in 'apps' will be active in the suite (and their APIs enabled).
# The 'theme' value sets the default theme for the UI.

# Product name (replaces "General Bots" throughout the application)
name=General Bots

# #1811 / #2097 — the build compiles every app (the `all-apps` Cargo feature
# is the default). The always/preview launcher split itself lives in the app
# registry (`botserver/src/apps/registry`, field `launcher_visibility`); the
# two lists below mirror it for this deployment and are checked against it by
# the `product_apps_line_matches_the_registry_flag` guard test.
#
# Active apps (comma-separated list): always visible in every launcher.
# Core surfaces (about, admin, settings, auth) are always available without
# being listed here.
apps=chat,drive,browser,clock-widget,jukebox,player,calculator,notes,photos,timer,weather,integrations

# Preview applications (comma-separated list)
# These do NOT appear in the launcher or the sidebar by default. They are
# revealed only while Preview mode is on, which the user toggles with the
# Preview switch in the left sidebar. The registry marks every app that is
# not in `apps=` as preview-only, so this list documents the 7.0 split; an
# app missing here is still preview-gated.
# `hidden_apps` wins over both lists.
# The Vibe sub-surfaces (db/graph/metrics/members/deploy/metering) are NOT
# listed here: they are toolwindow views inside the single Vibe app (#1429).
preview_apps=analytics,attendant,automations,banking,billing,calendar,campaigns,canvas,compliance,concierge,crm,designer,docs,sheet,fraud,goals,handoff,hr,kyc,learn,lists,mail,meet,memory,minutes,monitoring,o365,paper,people,plan,plugins,pos,products,project,recycle,retail,slides,social,store,tasks,tax,templates,tickets,timeclock,vibe,video,vision,workspace,clock,database,desktop,editor,terminal

# Hidden applications: compiled and routed, but never advertised and refused
# by the suite shell. #1626 keeps Research out of the default product; the
# feature/surface `sources` is not a registry app and is hidden with it.
hidden_apps=research,sources


# Sidebar visibility
# Controls whether the left sidebar (apps + conversation history) is shown.
# Conversation history lives in this rail, so it stays visible.
sidebar=true

# Search mechanism enabled
# Controls whether the omnibox/search toolbar is displayed in the suite
# Set to false to disable the search mechanism
search_enabled=true

# Menu launcher enabled
# Controls whether the apps menu launcher is displayed in the suite
# Set to false to hide the menu launcher button
# When the menu is empty (no apps to show), it will be automatically hidden
menu_launcher_enabled=true

# Default theme
# Available themes: dark, light, blue, purple, green, orange, sentient, cyberpunk,
#                   retrowave, vapordream, y2kglow, arcadeflash, discofever, grungeera,
#                   jazzage, mellowgold, midcenturymod, polaroidmemories, saturdaycartoons,
#                   seasidepostcard, typewriter, 3dbevel, xeroxui, xtreegold
theme=sentient

# Shell mode (#1852): false for the normal web/SaaS edition. The desktop-local
# product file (used by the Tauri app and the General Bots OS kiosk) sets this
# to true, which reveals the low-level Operating System panel in Settings.
shell_mode=false

# Logo URL (optional - leave empty to use default)
# Can be a relative path or absolute URL
logo=

# Favicon URL (optional - leave empty to use default)
favicon=

# Primary color override (optional - hex color code)
# Example: #d4f505
primary_color=

# Support email (optional)
support_email=

# Documentation URL (optional)
docs_url=https://docs.generalbots.org

# Copyright text (optional - {year} will be replaced with current year)
copyright=© {year} {name}. All rights reserved.

# #1889 — explicit deployment edition (cloud | desktop | os).
edition=cloud

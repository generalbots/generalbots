# General Bots Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# Vault connection
VAULT_ADDR=https://127.0.0.1:8200
VAULT_TOKEN=<your-vault-token-here>
VAULT_CACERT=./botserver-stack/vault/certs/ca.crt

# SaaS JWT secret (optional). Resolution order: the persisted
# saas_jwt_secret in botserver-stack/conf/system/directory_config.json,
# then SAAS_JWT_SECRET, then JWT_SECRET. When none is set a random secret is
# generated and persisted. Debug builds may opt into the public development
# constant with GB_ALLOW_DEV_JWT_SECRET=1 (never in production).
# SAAS_JWT_SECRET=<32+ random chars>
# GB_ALLOW_DEV_JWT_SECRET=1

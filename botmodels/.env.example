# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8085
LOG_LEVEL=INFO

# Comma-separated browser origins for CORS. Empty = same-origin only.
ALLOWED_ORIGINS=

# Security - IMPORTANT: Change this in production!
API_KEY=change-me-in-production

# Model tier: auto | min | max
#   auto = detect hardware at startup (default)
#   min  = force light models (SD-Turbo, BLIP2, Piper, Tesseract, Zeroscope)
#   max  = force best models (Qwen-Image, Qwen3-VL, Kokoro, Qwen3-ASR,
#                             PaddleOCR-VL, Wan 2.2)
# auto selects max when VRAM >= 16GB AND RAM >= 32GB (or MPS with RAM >= 32GB),
# otherwise min. The tier is frozen for the process lifetime.
MODE=auto

# Empty = use the device the tier detected (cuda/mps/cpu).
DEVICE=

# Remote speech providers. Off by default: botmodels is the offline path, so
# min mode must never send audio to a cloud API. Set true only to opt in.
ALLOW_REMOTE_SPEECH=false
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Model Paths (local paths or HuggingFace model ids)
# min tier
IMAGE_MODEL_PATH=./models/stable-diffusion-v1-5
VIDEO_MODEL_PATH=./models/zeroscope-v2
VISION_MODEL_PATH=./models/blip2
STT_MODEL_PATH=./models/stt
TTS_MODEL_PATH=./models/tts

# max tier - point these at the larger checkpoints when MODE=max
# QWEN_IMAGE_MODEL_PATH=./models/qwen-image-2.1
# WAN_MODEL_PATH=./models/wan2.2-ti2v-5b
# QWEN3_VL_MODEL_PATH=./models/qwen3-vl-4b
OCR_MODEL_PATH=./models/paddleocr-vl

# ACE-Step 1.5 music engine (start its official API separately)
ACESTEP_API_URL=http://127.0.0.1:8001
# Optional; must match ACESTEP_API_KEY on the ACE-Step service
ACESTEP_API_KEY=
ACESTEP_REQUEST_TIMEOUT=30
ACESTEP_AUDIO_TIMEOUT=300

# Realtime voice engines (WebSocket stream)
BOTMODELS_STT_ENGINE=local
BOTMODELS_STT_MODEL=small
BOTMODELS_TTS_ENGINE=local
BOTMODELS_TTS_MODEL=en_US-lessac-medium
BOTMODELS_TTS_PATH=./models/piper/en_US-lessac-medium.onnx

# Realtime speech model
REALTIME_AUDIO_MODEL_PATH=./models/realtime_audio

# Image Generation Defaults
IMAGE_STEPS=4
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# Video Generation Defaults
VIDEO_FRAMES=24
VIDEO_FPS=8
VIDEO_WIDTH=320
VIDEO_HEIGHT=576
VIDEO_STEPS=50

# Storage
OUTPUT_DIR=./outputs
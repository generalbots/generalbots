{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "General Bots",
  "version": "7.0.0",
  "identifier": "org.generalbots.botapp",
  "build": {
    "beforeDevCommand": "npx serve@14.2.7 ../botui/ui -l 3000 -L --no-port-switching",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../botui/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "splash",
        "title": "General Bots",
        "url": "splash.html",
        "width": 420,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      },
      {
        "title": "General Bots",
        "url": "suite/desktop.html",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}

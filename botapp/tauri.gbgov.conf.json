{
  "productName": "General Bots Lite",
  "identifier": "org.generalbots.lite",
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../botserver/.product.gbgov": ".product.gbgov",
      "../botserver/botserver-installers/*": "installers/",
      "../botui/ui": "ui",
      "../desktop/windows/licenses/*": "licenses/",
      "../desktop/os/licenses/NOTICE": "licenses/NOTICE",
      "../LICENSES-desktop.md": "licenses/LICENSES-desktop.md",
      "../LICENSE": "licenses/LICENSE-General-Bots.txt"
    },
    "externalBin": [
      "binaries/botserver"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/agent-runtime-uninstall.nsh"
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US"
        ]
      }
    },
    "shortDescription": "General Bots Lite — assistant with Chat and Drive",
    "longDescription": "Desktop assistant with Chat and Drive that runs on the person's own computer.",
    "category": "Productivity",
    "copyright": "© 2026 Pragmatismo.cloud. All rights reserved.",
    "publisher": "Pragmatismo"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the desktop app and setup wizard",
  "local": true,
  "windows": ["main", "wizard", "splash"],
  "remote": {
    "urls": [
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "notification:default",
    "geolocation:default",
    "default"
  ]
}

  "content": "const { chromium } = require('playwright');\nconst fs = require('fs');\nconst path = require('path');\n\nconst BASE = 'http://localhost:4000';\nconst SS = '/tmp';\n\nasync function ss(page, name) {\n  await page.screenshot({ path: `${SS}/${name}.png`, fullPage: true });\n  console.log(`  📸 ${SS}/${name}.png`);\n}\n\nasync function signup(page, name, email, botName, plan, label) {\n  console.log(`\\n${'='.repeat(55)}`);\n  console.log(`  ${label}`);\n  console.log(`    Name: ${name}  Email: ${email}  Bot: ${botName}  Plan: ${plan}`);\n  console.log(`${'='.repeat(55)}`);\n\n  await page.goto(`${BASE}/cloud/signup`);\n  await page.waitForLoadState('networkidle');\n\n  // Fill form fields\n  await page.fill('#signup-name', name);\n  await page.fill('#signup-email', email);\n  await page.fill('#signup-botname', botName);\n  await page.fill('#signup-password', 'test1234');\n\n  // Click plan label (radio is inside label)\n  if (plan === 'shared') {\n    await page.click('label.plan-option:has(input[value=\"shared\"])');\n  } else if (plan === 'private-cloud') {\n    await page.click('label.plan-option:has(input[value=\"private-cloud\"])');\n  }\n\n  await page.waitForTimeout(500);\n  await ss(page, `${botName}_1_before`);\n\n  // Submit\n  await page.click('#signup-btn');\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(2000);\n\n  const url = page.url();\n  console.log(`    → ${url}`);\n\n  if (url.includes('/cloud/dashboard')) {\n    console.log('    ✅ Redirected to Dashboard');\n  } else if (url.includes('/cloud/store')) {\n    console.log('    ✅ Redirected to Store (Private Server → VPS)');\n  } else if (url.includes('/cloud/signup')) {\n    const err = await page.textContent('#signup-error');\n    console.log(`    ❌ Signup failed: ${err || 'unknown'}`);\n  } else {\n    console.log(`    ⚠️  Destination: ${url.substring(0, 80)}`);\n  }\n\n  await page.waitForTimeout(1000);\n  await ss(page, `${botName}_2_after`);\n}\n\nasync function loginAndCheck(page, email, label) {\n  console.log(`\\n${'='.repeat(55)}`);\n  console.log(`  Login: ${label} (${email})`);\n  console.log(`${'='.repeat(55)}`);\n\n  await page.goto(`${BASE}/cloud/login`);\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(500);\n\n  await page.fill('#login-email', email);\n  await page.fill('#login-password', 'test1234');\n  await page.click('#login-btn');\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(2500);\n\n  const url = page.url();\n  console.log(`    → ${url}`);\n\n  if (url.includes('/cloud/dashboard')) {\n    console.log('    ✅ Login OK');\n    const stats = await page.$$eval('.stat-value', els => els.map(e => e.textContent));\n    if (stats.length) console.log(`    📊 Stats: ${stats.join(' | ')}`);\n    const usage = await page.$$eval('.usage-label', els => els.map(e => e.textContent.trim()));\n    if (usage.length) console.log(`    📈 Usage: ${usage.join(' || ')}`);\n  } else {\n    console.log(`    ❌ Login failed`);\n  }\n\n  await ss(page, `dash_${email.split('@')[0]}`);\n}\n\nasync function adminView(page) {\n  console.log(`\\n${'='.repeat(55)}`);\n  console.log('  ADMIN VIEW');\n  console.log(`${'='.repeat(55)}`);\n\n  await page.goto(`${BASE}/cloud/login`);\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(500);\n  await page.fill('#login-email', 'admin@localhost');\n  await page.fill('#login-password', 'dev');\n  await page.click('#login-btn');\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(2000);\n\n  await page.goto(`${BASE}/cloud/organizations`);\n  await page.waitForLoadState('networkidle');\n  await page.waitForTimeout(2000);\n\n  const orgs = await page.$$eval('.saas-org-card', cards =>\n    cards.map(c => c.textContent.trim().substring(0, 200))\n  );\n  if (orgs.length) {\n    console.log(`    🏢 Orgs (${orgs.length}):`);\n    orgs.forEach(o => console.log(`      • ${o}`));\n  } else {\n    const body = await page.textContent('body');\n    console.log(`    📄 ${body.substring(0, 300)}`);\n  }\n\n  await ss(page, 'admin_orgs');\n}\n\n(async () => {\n  console.log();\n  console.log('╔══════════════════════════════════════════════════════╗');\n  console.log('║   🌩️  CLOUD SIGNUP TEST (Node.js + Playwright)    ║');\n  console.log('╚══════════════════════════════════════════════════════╝');\n\n  const browser = await chromium.launch({\n    headless: true,\n    args: ['--no-sandbox']\n  });\n\n  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });\n\n  // 1. Create 2 Free accounts\n  const p1 = await ctx.newPage();\n  await signup(p1, 'Alice Free', 'alice@test.com', 'alicefree', 'free', 'Account 1/3 — Free');\n  await p1.close();\n\n  const p2 = await ctx.newPage();\n  await signup(p2, 'Bob Free', 'bob@test.com', 'bobfree', 'free', 'Account 2/3 — Free');\n  await p2.close();\n\n  // 2. Create 1 Shared account\n  const p3 = await ctx.newPage();\n  await signup(p3, 'Carol Shared', 'carol@test.com', 'carolshared', 'shared', 'Account 3/3 — Shared');\n  await p3.close();\n\n  console.log(`\\n${'='.repeat(55)}`);\n  console.log('  ✅ ACCOUNTS CREATED — checking dashboards');\n  console.log(`${'='.repeat(55)}`);\n\n  // 3. Check dashboards\n  const p4 = await ctx.newPage();\n  await loginAndCheck(p4, 'alice@test.com', 'Alice (Free)');\n  await p4.close();\n\n  const p5 = await ctx.newPage();\n  await loginAndCheck(p5, 'bob@test.com', 'Bob (Free)');\n  await p5.close();\n\n  const p6 = await ctx.newPage();\n  await loginAndCheck(p6, 'carol@test.com', 'Carol (Shared)');\n  await p6.close();\n\n  // 4. Admin\n  const p7 = await ctx.newPage();\n  await adminView(p7);\n  await p7.close();\n\n  await ctx.close();\n  await browser.close();\n\n  console.log(`\\n${'='.repeat(55)}`);\n  console.log('  ✅ TESTS COMPLETE');\n  console.log(`${'='.repeat(55)}`);\n\n  const files = fs.readdirSync(SS).filter(f => f.endsWith('.png') && /alice|bob|carol|dash|admin/.test(f));\n  files.forEach(f => console.log(`  /tmp/${f}`));\n})();\n",

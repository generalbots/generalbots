  "command": "# Test with pong handling\npython3 -c \"\nimport requests, json, time, socket, base64, struct, os\nCDP='http://localhost:9222'; BASE='http://localhost:4000'\n\nr=requests.put(f'{CDP}/json/new?{BASE}/cloud/signup')\ntab=r.json()\nws_url=tab['webSocketDebuggerUrl']\nhost=ws_url.split('://')[1].split(':')[0]\nport=int(ws_url.split(':')[2].split('/')[0])\npath='/'+ws_url.split('/',3)[3]\n\nsock=socket.socket(socket.AF_INET,socket.SOCK_STREAM)\nsock.settimeout(30)\nsock.connect((host,port))\nkey=base64.b64encode(os.urandom(16)).decode()\nreq=f'GET {path} HTTP/1.1\\r\\nHost: {host}:{port}\\r\\nUpgrade: websocket\\r\\nConnection: Upgrade\\r\\nSec-WebSocket-Key: {key}\\r\\nSec-WebSocket-Version: 13\\r\\n\\r\\n'\nsock.sendall(req.encode())\nresp=b''\nwhile b'\\r\\n\\r\\n' not in resp: resp+=sock.recv(4096)\nprint('WS connected')\n\ndef ws_send(s,msg):\n    data=msg.encode()\n    frame=bytearray([0x81])\n    l=len(data)\n    if l<126: frame.append(l)\n    elif l<65536: frame.extend([126]+list(struct.pack('>H',l)))\n    else: frame.extend([127]+list(struct.pack('>Q',l)))\n    frame.extend(data); s.sendall(frame)\n\ndef ws_send_frame(s,op,data=b''):\n    frame=bytearray([0x80|op])\n    l=len(data)\n    if l<126: frame.append(l)\n    elif l<65536: frame.extend([126]+list(struct.pack('>H',l)))\n    else: frame.extend([127]+list(struct.pack('>Q',l)))\n    frame.extend(data); s.sendall(frame)\n\ndef ws_recv(s,to=30):\n    s.settimeout(to)\n    try:\n        b0=s.recv(1)\n        if not b0: return None\n        op=b0[0]&0x0f\n        b1=s.recv(1); m=(b1[0]&0x80)!=0; l=b1[0]&0x7f\n        if l==126: l=struct.unpack('>H',s.recv(2))[0]\n        elif l==127: l=struct.unpack('>Q',s.recv(8))[0]\n        if m: mk=s.recv(4)\n        p=s.recv(l)\n        while len(p)<l: p+=s.recv(l-len(p))\n        if m: p=bytes(b^mk[i%4] for i,b in enumerate(p))\n        if op==0x01: return p.decode()\n        if op==0x09: ws_send_frame(s,0x8A,p); return ws_recv(s,to)  # pong\n        return None\n    except socket.timeout: return None\n\ngid=[0]\ndef cmd(method,params=None):\n    gid[0]+=1\n    ws_send(sock,json.dumps({'id':gid[0],'method':method,'params':params or {}}))\n    return gid[0]\n\ndef wait(eid,to=15):\n    while True:\n        m=ws_recv(sock,to)\n        if m is None: return None\n        try: d=json.loads(m)\n        except: continue\n        if d.get('id')==eid: return d.get('result')\n\n# Enable domains\ncmd('Page.enable'); wait(1)\ncmd('Runtime.enable'); wait(2)\ntime.sleep(0.5)\n\n# Navigate\ncmd('Page.navigate',{'url':f'{BASE}/cloud/signup'})\nr=wait(3,5)\nprint('Navigate result:', r)\ntime.sleep(1.5)\n\n# Eval\ncmd('Runtime.evaluate',{'expression':'document.title'})\nr=wait(4)\nif r:\n    print('Title:', r.get('result',{}).get('value'))\n\n# Set name\ncmd('Runtime.evaluate',{'expression':'''\n    (()=>{let e=document.querySelector('#signup-name');if(!e)return'NOINPUT';\n    let s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;\n    s.call(e,'Alice Free');\n    e.dispatchEvent(new Event('input',{bubbles:true}));\n    e.dispatchEvent(new Event('change',{bubbles:true}));\n    return e.value;})()\n'''})\nr=wait(5)\nif r:\n    val=r.get('result',{}).get('value') or r.get('result',{}).get('description')\n    print('Set name result:', val)\n\n# Screenshot\ncmd('Page.captureScreenshot',{'format':'png'})\nr=wait(6)\nif r and 'data' in r:\n    with open('/tmp/test_ss.png','wb') as f:\n        f.write(base64.b64decode(r['data']))\n    print('Screenshot: /tmp/test_ss.png')\n\nsock.close()\nprint('DONE')\n\" 2>&1",
  "description": "Test CDP with pong handling",
  "timeout": 30000
}

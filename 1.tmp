The botserver is alive and there are 11 Chrome tabs, including signup and login tabs. Let me rewrite the CDP test script to be simpler and handle errors better. Instead of the complex WebSocket approach, let me use a simpler method:
1. Navigate to the signup page 
2. Inject JavaScript directly into the page using CDP's Runtime.evaluate
3. Take screenshots

Let me rewrite the script to be more robust.

**Tool: write**

**Input:**
```json
{
  "filePath": "/tmp/cdp_test2.py",
  "content": "#!/usr/bin/env python3\n\"\"\"CDP Test — create accounts via Chrome + verify dashboards.\nUses raw WebSocket (no deps) with retry logic.\"\"\"\nimport json, time, socket, base64, hashlib, struct, os, sys, requests\n\nCDP = 'http://localhost:9222'\nBASE = 'http://localhost:4000'\n\n# ── Minimal WebSocket ──\ndef ws_connect(ws_url, timeout=30):\n    host = ws_url.split('://')[1].split(':')[0]\n    port = int(ws_url.split(':')[2].split('/')[0])\n    path = '/' + ws_url.split('/', 3)[3]\n    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    sock.settimeout(timeout)\n    sock.connect((host, port))\n    key = base64.b64encode(os.urandom(16)).decode()\n    req = (f\"GET {path} HTTP/1.1\\r\\nHost: {host}:{port}\\r\\nUpgrade: websocket\\r\\nConnection: Upgrade\\r\\nSec-WebSocket-Key: {key}\\r\\nSec-WebSocket-Version: 13\\r\\n\\r\\n\")\n    sock.sendall(req.encode())\n    resp = b\"\"\n    while b\"\\r\\n\\r\\n\" not in resp:\n        resp += sock.recv(4096)\n    return sock\n\ndef ws_send(sock, msg):\n    data = msg.encode('utf-8')\n    frame = bytearray([0x81])\n    l = len(data)\n    if l < 126: frame.append(l)\n    elif l < 65536: frame.extend([126]+list(struct.pack('>H',l)))\n    else: frame.extend([127]+list(struct.pack('>Q',l)))\n    frame.extend(data)\n    sock.sendall(frame)\n\ndef ws_recv(sock, _to=30):\n    sock.settimeout(_to)\n    try:\n        b0 = sock.recv(1)\n        if not b0: return None\n        op = b0[0] & 0x0f\n        b1 = sock.recv(1)\n        m = (b1[0] & 0x80)!=0\n        l = b1[0] & 0x7f\n        if l==126: l=struct.unpack('>H',sock.recv(2))[0]\n        elif l==127: l=struct.unpack('>Q',sock.recv(8))[0]\n        if m: mk=sock.recv(4)\n        p=sock.recv(l)\n        while len(p)<l: p+=sock.recv(l-len(p))\n        if m: p=bytes(b^mk[i%4] for i,b in enumerate(p))\n        return p.decode('utf-8') if op==0x01 else None\n    except socket.timeout: return None\n\n# ── CDP helpers ──\ngid=[0]\ndef cmd(ws, method, params=None):\n    gid[0]+=1; j=json.dumps({\"id\":gid[0],\"method\":method,\"params\":params or {}})\n    ws_send(ws,j); return gid[0]\n\ndef wait(ws, eid, to=15):\n    while True:\n        m=ws_recv(ws,to)\n        if m is None: return None\n        try: d=json.loads(m)\n        except: continue\n        if d.get(\"id\")==eid: return d.get(\"result\")\n\ndef js(ws, expr):\n    cmd(ws,\"Runtime.evaluate\",{\"expression\":expr})\n    r=wait(ws,gid[0])\n    if r: return r.get(\"result\",{}).get(\"value\") or r.get(\"result\",{}).get(\"description\")\n    return None\n\ndef ss(ws, path):\n    cmd(ws,\"Page.captureScreenshot\",{\"format\":\"png\"})\n    r=wait(ws,gid[0])\n    if r and \"data\" in r:\n        with open(path,\"wb\") as f: f.write(base64.b64decode(r[\"data\"]))\n        print(f\"  📸 {path}\")\n\ndef set_val(ws, sel, val):\n    return js(ws,f\"\"\"\n    (()=>{{let e=document.querySelector('{sel}');if(!e)return 'NOTFOUND';\n    let s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;\n    s.call(e,'{val}');e.dispatchEvent(new Event('input',{{bubbles:true}}));\n    e.dispatchEvent(new Event('change',{{bubbles:true}}));return e.value;}})()\n    \"\"\")\n\ndef click(ws, sel):\n    return js(ws,f\"document.querySelector('{sel}')?.click()\")\n\ndef url(ws):\n    return js(ws,\"window.location.href\")\n\n# ── Test helpers ──\ndef new_tab(u):\n    r=requests.put(f\"{CDP}/json/new?{u}\")\n    return r.json()\n\ndef tab_ws(t):\n    return t[\"webSocketDebuggerUrl\"]\n\ndef create_acct(name, email, bot, plan, label):\n    \"\"\"Create account by filling signup form via CDP.\"\"\"\n    tab=new_tab(f\"{BASE}/cloud/signup\")\n    ws=ws_connect(tab_ws(tab))\n    cmd(ws,\"Page.enable\"); wait(ws,gid[0],2)\n    cmd(ws,\"Runtime.enable\"); wait(ws,gid[0],2)\n    time.sleep(1.5)\n\n    print(f\"\\n{'='*55}\")\n    print(f\"  Creating {label}\")\n    print(f\"    Name: {name}  Email: {email}  Bot: {bot}  Plan: {plan}\")\n    print(f\"{'='*55}\")\n\n    set_val(ws,\"#signup-name\",name); time.sleep(0.3)\n    set_val(ws,\"#signup-email\",email); time.sleep(0.3)\n    set_val(ws,\"#signup-botname\",bot); time.sleep(0.3)\n    set_val(ws,\"#signup-password\",\"test1234\"); time.sleep(0.3)\n\n    if plan==\"shared\": click(ws,'input[name=\"plan\"][value=\"shared\"]')\n    elif plan==\"private-cloud\": click(ws,'input[name=\"plan\"][value=\"private-cloud\"]')\n    time.sleep(0.5)\n\n    ss(ws,f\"/tmp/{bot}_1_before.png\")\n\n    # Submit\n    js(ws,\"document.getElementById('signup-form').requestSubmit()\")\n    time.sleep(3.5)\n\n    u=url(ws)\n    print(f\"    → {u}\")\n    if \"dashboard\" in str(u):\n        print(f\"    ✅ Redirected to Dashboard\")\n    elif \"store\" in str(u):\n        print(f\"    ✅ Redirected to Store (Private Server → VPS)\")\n    elif \"signup\" in str(u):\n        err=js(ws,\"document.getElementById('signup-error')?.textContent||'none'\")\n        print(f\"    ❌ Still on signup: {err}\")\n    else: print(f\"    ⚠️  Unknown: {u[:80]}\")\n\n    time.sleep(1)\n    ss(ws,f\"/tmp/{bot}_2_after.png\")\n    ws.close()\n    return u\n\ndef login_and_verify(email, label):\n    \"\"\"Login and check dashboard.\"\"\"\n    tab=new_tab(f\"{BASE}/cloud/login\")\n    ws=ws_connect(tab_ws(tab))\n    cmd(ws,\"Page.enable\"); wait(ws,gid[0],2)\n    cmd(ws,\"Runtime.enable\"); wait(ws,gid[0],2)\n    time.sleep(1.5)\n\n    print(f\"\\n{'='*55}\")\n    print(f\"  Login as {label} ({email})\")\n    print(f\"{'='*55}\")\n\n    set_val(ws,\"#login-email\",email); time.sleep(0.3)\n    set_val(ws,\"#login-password\",\"test1234\"); time.sleep(0.3)\n    js(ws,\"document.getElementById('login-form').requestSubmit()\")\n    time.sleep(3)\n\n    u=url(ws)\n    print(f\"    → {u}\")\n    if \"dashboard\" in str(u):\n        print(f\"    ✅ Login ok, dashboard loaded\")\n        stats=js(ws,\"(()=>{let e=document.querySelectorAll('.stat-value');return Array.from(e).map(x=>x.textContent).join(' | ')})()\")\n        if stats: print(f\"    📊 {stats}\")\n        usage=js(ws,\"(()=>{let e=document.querySelectorAll('.usage-label');return Array.from(e).map(x=>x.textContent.trim()).join(' || ')})()\")\n        if usage: print(f\"    📈 {usage}\")\n    else: print(f\"    ❌ Login failed\")\n\n    ss(ws,f\"/tmp/dash_{email.split('@')[0]}.png\")\n    ws.close()\n\ndef admin_view():\n    tab=new_tab(f\"{BASE}/cloud/organizations\")\n    ws=ws_connect(tab_ws(tab))\n    cmd(ws,\"Page.enable\"); wait(ws,gid[0],2)\n    cmd(ws,\"Runtime.enable\"); wait(ws,gid[0],2)\n    time.sleep(1.5)\n\n    print(f\"\\n{'='*55}\")\n    print(f\"  Admin View (orgs page)\")\n    print(f\"{'='*55}\")\n\n    # Login as admin first\n    set_val(ws,\"#login-email\",\"admin@localhost\"); time.sleep(0.3)\n    set_val(ws,\"#login-password\",\"dev\"); time.sleep(0.3)\n    js(ws,\"document.getElementById('login-form').requestSubmit()\")\n    time.sleep(3)\n\n    u=url(ws)\n    print(f\"    → {u}\")\n\n    # Navigate to orgs\n    js(ws,\"window.location.href='/cloud/organizations'\")\n    time.sleep(2.5)\n    u2=url(ws)\n    print(f\"    → {u2}\")\n\n    orgs=js(ws,\"(()=>{let c=document.querySelectorAll('.saas-org-card');return Array.from(c).map(x=>x.textContent.trim().substring(0,180)).join('\\\\n---\\\\n')})()\")\n    if orgs: print(f\"    🏢 Orgs:\\n{orgs}\")\n    else: \n        txt=js(ws,\"document.body.innerText.substring(0,500)\")\n        print(f\"    📄 Page: {txt[:200]}\")\n\n    ss(ws,\"/tmp/admin_orgs.png\")\n    ws.close()\n\n# ── TEST RUN ──\nif __name__==\"__main__\":\n    print()\n    print(\"╔══════════════════════════════════════════════════════╗\")\n    print(\"║     🌩️  CLOUD SIGNUP + DASHBOARD TEST             ║\")\n    print(\"╚══════════════════════════════════════════════════════╝\")\n\n    # Clean up old test data from DB first\n    PG_BIN=\"/home/a404011/src/generalbots/botserver-stack/bin/tables/bin\"\n    import subprocess\n    env=os.environ.copy()\n    env[\"PGPASSWORD\"]=\"h6c6DnWjA77O8g1x9Sv1kzisdFjUBWOy\"\n    for tbl, cond in [(\"bots\",\"name IN ('alicefree','bobfree','carolshared')\"),\n                       (\"branches\",\"name IN ('alicefree','bobfree','carolshared')\"),\n                       (\"organizations\",\"name IN ('alicefree','bobfree','carolshared')\")]:\n        subprocess.run([PG_BIN+\"/psql\",\"-h\",\"localhost\",\"-U\",\"gbuser\",\"-d\",\"botserver\",\n                       \"-c\",f\"DELETE FROM {tbl} WHERE {cond}\"],\n                      env=env, capture_output=True)\n\n    # 1. Create 2 Free accounts\n    create_acct(\"Alice Free\",\"alice@test.com\",\"alicefree\",\"free\",\"Account 1/3 — Free\")\n    create_acct(\"Bob Free\",\"bob@test.com\",\"bobfree\",\"free\",\"Account 2/3 — Free\")\n\n    # 2. Create 1 Shared account\n    create_acct(\"Carol Shared\",\"carol@test.com\",\"carolshared\",\"shared\",\"Account 3/3 — Shared (trial)\")\n\n    print(f\"\\n{'='*55}\")\n    print(\"  ✅ ALL 3 ACCOUNTS CREATED\")\n    print(\"  Checking dashboards...\")\n    print(f\"{'='*55}\")\n\n    # 3. Check dashboards\n    login_and_verify(\"alice@test.com\",\"Alice (Free)\")\n    login_and_verify(\"bob@test.com\",\"Bob (Free)\")\n    login_and_verify(\"carol@test.com\",\"Carol (Shared)\")\n\n    # 4. Admin view\n    admin_view()\n\n    print(f\"\\n{'='*55}\")\n    print(\"  ✅ TESTS COMPLETE\")\n    print(f\"{'='*55}\")\n    print(\"Screenshots in /tmp/:\")\n    for f in sorted(os.listdir(\"/tmp\")):\n        if f.endswith(\".png\") and any(x in f for x in [\"alice\",\"bob\",\"carol\",\"dash\",\"admin\"]):\n            print(f\"  /tmp/{f}\")\n"
}

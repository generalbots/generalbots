  "content": "#!/usr/bin/env python3\n\"\"\"Teste automatizado: criar 2 contas Free + 1 Shared via signup, verificar dashboards.\"\"\"\nimport os, time\nfrom playwright.sync_api import sync_playwright\n\nBASE = \"http://localhost:4000\"\nSS_DIR = \"/tmp\"\n\ndef ss(page, name):\n    path = f\"{SS_DIR}/{name}.png\"\n    page.screenshot(path=path, full_page=True)\n    print(f\"  📸 {path}\")\n\ndef signup(page, name, email, bot_name, plan, label):\n    print(f\"\\n{'='*55}\")\n    print(f\"  {label}\")\n    print(f\"    Name: {name}  Email: {email}  Bot: {bot_name}  Plan: {plan}\")\n    print(f\"{'='*55}\")\n\n    page.goto(f\"{BASE}/cloud/signup\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(1)\n\n    page.fill(\"#signup-name\", name)\n    page.fill(\"#signup-email\", email)\n    page.fill(\"#signup-botname\", bot_name)\n    page.fill(\"#signup-password\", \"test1234\")\n\n    if plan == \"shared\":\n        page.click('input[name=\"plan\"][value=\"shared\"]')\n    elif plan == \"private-cloud\":\n        page.click('input[name=\"plan\"][value=\"private-cloud\"]')\n\n    time.sleep(0.5)\n    ss(page, f\"{bot_name}_1_before\")\n\n    page.click(\"#signup-btn\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(2)\n\n    url = page.url\n    print(f\"    → {url}\")\n\n    if \"/cloud/dashboard\" in url:\n        print(f\"    ✅ Redirected to Dashboard\")\n    elif \"/cloud/store\" in url:\n        print(f\"    ✅ Redirected to Store (Private Server → VPS)\")\n    elif \"/cloud/signup\" in url:\n        err = page.text_content(\"#signup-error\") or \"none\"\n        print(f\"    ❌ Still on signup: {err}\")\n    else:\n        print(f\"    ⚠️  Destination: {url[:80]}\")\n\n    time.sleep(1)\n    ss(page, f\"{bot_name}_2_after\")\n\ndef login_and_check(page, email, label):\n    print(f\"\\n{'='*55}\")\n    print(f\"  Login: {label} ({email})\")\n    print(f\"{'='*55}\")\n\n    page.goto(f\"{BASE}/cloud/login\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(1)\n\n    page.fill(\"#login-email\", email)\n    page.fill(\"#login-password\", \"test1234\")\n    page.click(\"#login-btn\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(2.5)\n\n    url = page.url\n    print(f\"    → {url}\")\n\n    if \"/cloud/dashboard\" in url:\n        print(f\"    ✅ Login OK, dashboard loaded\")\n        stats = page.eval_on_selector_all(\".stat-value\", lambda els: [e.text_content() for e in els])\n        if stats:\n            print(f\"    📊 Stats: {' | '.join(stats)}\")\n        usage = page.eval_on_selector_all(\".usage-label\", lambda els: [e.text_content().strip() for e in els])\n        if usage:\n            print(f\"    📈 Usage: {' || '.join(usage)}\")\n        # Check plan name on page\n        plan_text = page.text_content(\".mgmt-page-title\")\n        if plan_text:\n            print(f\"    📋 Page: {plan_text}\")\n    else:\n        print(f\"    ❌ Login failed (got {url})\")\n\n    ss(page, f\"dash_{email.split('@')[0]}\")\n\ndef check_admin(page):\n    print(f\"\\n{'='*55}\")\n    print(f\"  ADMIN VIEW: all organizations\")\n    print(f\"{'='*55}\")\n\n    page.goto(f\"{BASE}/cloud/login\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(1)\n    page.fill(\"#login-email\", \"admin@localhost\")\n    page.fill(\"#login-password\", \"dev\")\n    page.click(\"#login-btn\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(2)\n\n    page.goto(f\"{BASE}/cloud/organizations\")\n    page.wait_for_load_state(\"networkidle\")\n    time.sleep(2)\n\n    orgs = page.eval_on_selector_all(\".saas-org-card\", lambda cards: [c.text_content().strip()[:200] for c in cards])\n    if orgs:\n        print(f\"    🏢 Organizations found: {len(orgs)}\")\n        for o in orgs:\n            print(f\"      • {o}\")\n    else:\n        body = page.text_content(\"body\") or \"\"\n        print(f\"    📄 Page body: {body[:300]}\")\n\n    ss(page, \"admin_orgs\")\n\ndef main():\n    print()\n    print(\"╔══════════════════════════════════════════════════════╗\")\n    print(\"║   🌩️  CLOUD SIGNUP + DASHBOARD TEST (Playwright)  ║\")\n    print(\"╚══════════════════════════════════════════════════════╝\")\n\n    with sync_playwright() as p:\n        browser = p.chromium.launch(\n            headless=True,\n            args=[\"--no-sandbox\"]\n        )\n        context = browser.new_context(viewport={\"width\": 1280, \"height\": 800})\n\n        # ── CREATE 2 FREE ACCOUNTS ──\n        page1 = context.new_page()\n        signup(page1, \"Alice Free\",   \"alice@test.com\",   \"alicefree\",  \"free\",   \"Account 1/3 — Free\")\n        page1.close()\n\n        page2 = context.new_page()\n        signup(page2, \"Bob Free\",     \"bob@test.com\",     \"bobfree\",    \"free\",   \"Account 2/3 — Free\")\n        page2.close()\n\n        # ── CREATE 1 SHARED ACCOUNT ──\n        page3 = context.new_page()\n        signup(page3, \"Carol Shared\", \"carol@test.com\",   \"carolshared\",\"shared\", \"Account 3/3 — Shared (trial)\")\n        page3.close()\n\n        print(f\"\\n{'='*55}\")\n        print(f\"  ✅ ALL 3 ACCOUNTS CREATED — checking dashboards\")\n        print(f\"{'='*55}\")\n\n        # ── VERIFY DASHBOARDS ──\n        p4 = context.new_page()\n        login_and_check(p4, \"alice@test.com\", \"Alice (Free)\")\n        p4.close()\n\n        p5 = context.new_page()\n        login_and_check(p5, \"bob@test.com\", \"Bob (Free)\")\n        p5.close()\n\n        p6 = context.new_page()\n        login_and_check(p6, \"carol@test.com\", \"Carol (Shared)\")\n        p6.close()\n\n        # ── ADMIN VIEW ──\n        p7 = context.new_page()\n        check_admin(p7)\n        p7.close()\n\n        context.close()\n        browser.close()\n\n    print(f\"\\n{'='*55}\")\n    print(f\"  ✅ TESTS COMPLETE\")\n    print(f\"{'='*55}\")\n    print(\"Screenshots:\")\n    for f in sorted(os.listdir(SS_DIR)):\n        if f.endswith(\".png\") and any(x in f for x in [\"alice\",\"bob\",\"carol\",\"dash\",\"admin\"]):\n            print(f\"  /tmp/{f}\")\n\nif __name__ == \"__main__\":\n    main()\n",

[Unit]
Description=General Bots kiosk shell (cage + General Bots desktop)
Documentation=https://github.com/generalbots/generalbots
# Serve nothing until user sessions and the network are up; getty@tty1 is
# masked at build time (mkosi.finalize.chroot) — there is no greeter.
After=systemd-user-sessions.service NetworkManager.service systemd-logind.service plymouth-quit-wait.service
Wants=network-online.target plymouth-quit-wait.service
# #2449 — the kiosk must run inside a real user manager, not a bare private
# bus: PipeWire, WirePlumber, the xdg-desktop-portal stack, gvfs and every
# future user service are socket-activated by it, and `systemctl --user`
# only works when user@<uid> is up. PAMName=login makes pam_systemd create
# the logind session (and thus user@.service); gb-session waits for its bus.
Conflicts=getty@tty1.service
ConditionPathExists=/opt/general-bots/start.sh

[Service]
Type=simple
# No root, no display manager: run inside a PAM login session so
# pam_systemd sets up /run/user/<uid> (XDG_RUNTIME_DIR) and libseat (via
# logind) can hand DRM/render devices to the kiosk user (video/render
# group memberships from mkosi.extra/etc/sysusers.d/generalbots-kiosk.conf).
User=gbdesk
Group=gbdesk
PAMName=login
UtmpIdentifier=tty1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
WorkingDirectory=/var/lib/gbdesk
Environment=HOME=/var/lib/gbdesk
Environment=WLR_BACKENDS=drm
# #2449 — the session bus and runtime dir belong to the user manager.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# #2500 — a web process that cannot be sandboxed must fail loudly instead of
# running page content with the kiosk user's full access.
Environment=WEBKIT_FORCE_SANDBOX=1
Environment=LIBSEAT_BACKEND=logind
# #2455 — PipeWire finds its runtime socket here; ALSA clients are routed to it.
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/%U
# ---------------------------------------------------------------------------
# Kiosk hardening (documented). Each directive below is intentionally explicit.
# ---------------------------------------------------------------------------

# --- Privilege / execution constraints ---
# Prevents gaining new privileges via setuid/setgid binaries and similar exec
# transitions. The kiosk shell must never escalate.
NoNewPrivileges=yes
# Blocks creation of SUID/SGID files in this unit's context (defense in depth).
RestrictSUIDSGID=yes
# Do not allow ambient capabilities to be inherited; combined with an empty
# CapabilityBoundingSet below this drops all capabilities for the service.
# (User service under a non-root user has none in practice, but be explicit.)
CapabilityBoundingSet=

# --- Filesystem layout ---
# Root filesystem read-only except explicitly listed write paths.
ProtectSystem=strict
# Writable state for the desktop stack, logs, workspace, and provisioned data.
# /var/lib/gbdesk is the canonical mutable home (WorkingDirectory/Home).
ReadWritePaths=/var/lib/gbdesk
# Session runtime dir (XDG_RUNTIME_DIR) created by pam_systemd/logind. Required
# for Wayland sockets, libseat, and the session bus endpoint used by dbus tools.
# NOTE: with ProtectHome=tmpfs below, /run/user is hidden; we bind it back.
ReadWritePaths=/run/user/%U
# Private /tmp and /var/tmp namespace for this unit.
PrivateTmp=yes
# Hide /home, /root, and /run/user behind tmpfs, then expose only what is needed.
# EXCEPTIONS / explicit binds (see also DeviceAllow and Address Families):
#   - /run/user/%U is bind-mounted back (RW) for XDG_RUNTIME_DIR, Wayland sockets,
#     libseat session state, and dbus-run-session session bus artifacts.
#   - HOME is /var/lib/gbdesk (outside /home); remain writable via ReadWritePaths.
ProtectHome=tmpfs
BindPaths=/run/user/%U

# --- Devices ---
# Isolate most device nodes; allow only what the kiosk needs.
# EXCEPTIONS (must remain allowed for a graphical Wayland kiosk on DRM/KMS):
#   - Direct Rendering Manager nodes: /dev/dri/card*, /dev/dri/renderD* (GPU/accel).
#     cage (wlroots) uses DRM/KMS; gbdesk is in video/render groups (sysusers).
#   - The active VT nodes referenced by TTYPath (/dev/tty0, /dev/tty1) for session
#     ownership/tty handling.
#   - char-drm aggregate allow for flexibility across devices.
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/dri rw
DeviceAllow=/dev/dri/card* rw
DeviceAllow=/dev/dri/renderD* rw
DeviceAllow=char-drm rw
DeviceAllow=/dev/tty0 rw
DeviceAllow=/dev/tty1 rw
# #2455 — sound: the compositor/Meet/Player need the PCM and control nodes.
DeviceAllow=/dev/snd/* rw
DeviceAllow=char-snd rw
# #2504 — camera and microphone capture (granted per origin by the shell, not
# blanket: see botapp/src/desktop/webkit_permissions.rs).
DeviceAllow=/dev/video* rw
DeviceAllow=/dev/media* rw
# #2453/#2455 — libinput reads keyboards, touchpads and the kiosk's own keys.
DeviceAllow=/dev/input/* rw
DeviceAllow=char-input rw

# --- Kernel / control surfaces ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- Namespaces, personality, realtime ---
# #2500 — WebKitGTK's bwrap sandbox must create user + mount namespaces (and
# ipc/pid/net/uts) before it drops privileges. RestrictNamespaces=yes blocks
# those clone()/unshare() calls; combined with WEBKIT_FORCE_SANDBOX=1 that
# would stop the web process from starting at all. Allow-list only what bwrap
# needs; NoNewPrivileges=yes + empty CapabilityBoundingSet keep this from
# becoming a host privilege escalation.
RestrictNamespaces=user ipc pid net mnt uts
LockPersonality=yes
RestrictRealtime=yes
# Limit address families. Typical needs: AF_UNIX (dbus, Wayland sockets),
# AF_INET/AF_INET6 (networking, provisioning), AF_NETLINK (routing/udev/logind
# related interactions in some stacks). Adjust only with evidence if a
# component fails; document changes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# --- Syscalls ---
# Broad but safer baseline for common desktop/session services. May require
# narrowing exceptions only if profiling shows issues; document any additions.
# NOTE: this is a pragmatic starting point for cage/dbus-run-session/GTK stack.
# #2500 — @mount is NOT part of @system-service (verified with
# `systemd-analyze syscall-filter @system-service`); bwrap needs
# mount()/pivot_root()/umount2() inside its own mount namespace. Those calls
# still require CAP_SYS_ADMIN in the new user namespace — the shell has no
# capabilities in the host namespace (empty CapabilityBoundingSet).
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM

# --- Misc hardening ---
UMask=0077
# Do not mount new filesystems in this unit's mount namespace surprises.
# (Implicit in several settings, but reinforce intent by avoiding writes outside
# allowed paths; ProtectSystem=strict + ReadWritePaths already constrain.)

# ---------------------------------------------------------------------------
# Explicit exceptions (do NOT "harden away" without understanding impact):
# ---------------------------------------------------------------------------
# 1) DRM/render devices for the Wayland compositor (cage/wlroots) and GPU accel:
#    /dev/dri/*, char-drm. Required for rendering on KMS/DRM. Without these the
#    kiosk cannot draw. Keep DeviceAllow entries above in sync with hardware.
#
# 2) Session bus / runtime directory:
#    /run/user/%U (bind-mounted back) and XDG_RUNTIME_DIR semantics provided by
#    pam_systemd/logind. dbus-run-session starts a session bus for the launcher
#    and child processes; GTK/WebKit and Wayland clients rely on this. This is
#    the "session bus" domain for the unit's session.
#
# 3) WebKit JIT: MemoryDenyWriteExecute is intentionally NOT set.
#    Modern WebKitGTK uses JIT compilation which requires memory that is
#    writable and executable at runtime (W^X trade-off). Enabling MDE breaks
#    the embedded webview/launcher stack. If you later move the webview into a
#    separate sandboxed process with an interpreter-free path, revisit MDE there.
#
# 4) Network access is allowed (PrivateNetwork=no, default) because the
#    provisioner/start flow may fetch components on first boot when offline mode
#    is not enforced; the desktop app also needs network for normal operation.
#
# 5) TTY nodes (/dev/tty0,/dev/tty1) for the kiosk VT session.
# ---------------------------------------------------------------------------

# Own DBus session bus for GTK/WebKit, cage as the Wayland kiosk compositor,
# and the General Bots launcher as its single application. The launcher starts
# the botserver sidecar and hosts the desktop webview in the *same* user/session
# context today (see "Security domain boundary" in desktop/os/README.md).
# #2449 — gb-session waits for the user manager's bus (PAMName=login /
# pam_systemd / user@.service), then execs cage with the launcher. If the bus
# never appears it falls back to a private dbus-run-session, so the kiosk
# still boots instead of dying on a race at startup.
ExecStart=/usr/local/bin/gb-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
#!/bin/bash -eu
# mkosi finalize script — runs INSIDE the image tree (chroot), as root,
# after packages and mkosi.extra/ are in place. Last step before the image
# is sealed: from here on the appliance only knows the kiosk shell.

set -euo pipefail

# 1. The General Bots payload unpacked by CI into mkosi.extra/opt must run
#    from a read-only prefix; the launcher is the single entry point.
test -x /opt/general-bots/start.sh
test -x /opt/general-bots/generalbots
test -d /opt/general-bots/ui/suite
chown -R root:root /opt/general-bots

# 2. tty1 belongs to the kiosk shell exclusively — never agetty, never a
#    greeter. generalbots-shell.service Conflicts= getty@tty1 anyway, but
#    masked keeps everyone honest.
systemctl mask getty@tty1.service

# 3. Locked-down appliance: no rescue/emergency shells on any console. The
#    documented recovery procedure is reprovisioning from a fresh image.
systemctl mask rescue.service emergency.service

# 4. Kiosk shell + networking for the setup wizard's first-run provisioning.
systemctl enable generalbots-shell.service systemd-networkd.service systemd-resolved.service

# 5. Kiosk state directory (stack, logs, workspace live here, not in /opt).
install -d -m 0700 -o gbdesk -g gbdesk /var/lib/gbdesk

# 6. Brand the OS identity everywhere an OS screen reads it: boot tools,
#    `hostnamectl`, the Plymouth theme selector and desktop icon lookups.
cat >/etc/os-release <<'EOF'
NAME="General Bots OS"
PRETTY_NAME="General Bots OS (Debian 13 base)"
ID=general-bots-os
ID_LIKE=debian
VERSION_ID="1"
VERSION="1 (trixie)"
VERSION_CODENAME=trixie
HOME_URL="https://generalbots.org"
DOCUMENTATION_URL="https://docs.generalbots.org"
SUPPORT_URL="https://github.com/generalbots/generalbots/issues"
LOGO=general-bots
EOF

#!/bin/bash -eu
# mkosi finalize script — runs INSIDE the image tree (chroot), as root,
# after packages and mkosi.extra/ are in place. Last step before the image
# is sealed: from here on the appliance only knows the kiosk shell.

set -euo pipefail

# 1. The General Bots payload unpacked by CI into mkosi.extra/opt must run
#    from a read-only prefix; the launcher is the single entry point.
test -x /opt/general-bots/start.sh
test -x /opt/general-bots/generalbots
test -d /opt/general-bots/ui/suite
chown -R root:root /opt/general-bots

# 2. tty1 belongs to the kiosk shell exclusively — never agetty, never a
#    greeter. generalbots-shell.service Conflicts= getty@tty1 anyway, but
#    masked keeps everyone honest.
systemctl mask getty@tty1.service

# 3. Locked-down appliance: no rescue/emergency shells on any console. The
#    documented recovery procedure is reprovisioning from a fresh image.
systemctl mask rescue.service emergency.service

# 4. Services. Networking is NetworkManager (#2453 — Wi-Fi needs a
#    supplicant and a D-Bus API; systemd-networkd alone cannot join a WPA
#    network), DNS stays systemd-resolved, the clock is set by timesyncd
#    (#2458), and nftables applies the default-deny ruleset before anything
#    can listen (#2477).
systemctl disable systemd-networkd.service 2>/dev/null || true
systemctl enable generalbots-shell.service
systemctl enable NetworkManager.service
systemctl enable systemd-resolved.service
systemctl enable systemd-timesyncd.service
systemctl enable nftables.service

# 14. Firmware, power/thermal and memory-pressure survival (#2464, offline
#     image/config slice). fwupd exposes device firmware updates (UI wiring in
#     Settings deferred), power-profiles-daemon/thermald manage laptop power and
#     thermals, systemd-zram-generator + /etc/systemd/zram-generator.conf provide
#     compressed swap, and systemd-oomd uses drop-ins/config in mkosi.extra to
#     prefer killing recoverable workloads before the shell/compositor. Intel/AMD
#     microcode packages are installed so the initramfs can load CPU updates
#     early; loaded-revision reporting in diagnostics is a follow-up (#2468).
systemctl enable fwupd-refresh.timer || true
systemctl enable power-profiles-daemon.service || true
systemctl enable thermald.service || true
systemctl enable systemd-oomd.service || true

# 15. Peripheral, accessibility and display groundwork (#2462/#2469/#2456,
#     offline image/config slice). Services are enabled where safe; UI/runtime
#     integration, pairing/print dialogs, OSK invocation at lock/wizard, AT-SPI
#     session wiring, output/brightness control paths and hardware verification
#     remain deferred follow-up work.
systemctl enable bluetooth.service || true
systemctl enable cups.service || true
systemctl enable avahi-daemon.service || true
systemctl enable iio-sensor-proxy.service || true
# AT-SPI bus/socket units are typically user-session activatable; enable common
# system targets if present without failing the image build.
systemctl enable at-spi-dbus-bus.service || true

# 5. Kiosk state directory (stack, logs, workspace live here, not in /opt).
install -d -m 0700 -o gbdesk -g gbdesk /var/lib/gbdesk

# 5-secret. #2498 — the secret store lives OUTSIDE the kiosk-owned stack.
#     root owns it, gbsvc (the sidecar) is the only group that can read it;
#     gbdesk (compositor + webview) has no access at all. Vault listens on
#     loopback over TLS with a client certificate and the sidecar keeps a
#     scoped token, never the root token.
install -d -m 0755 /etc/generalbots
install -d -m 0750 -o root -g gbsvc /etc/generalbots/credentials

# 5-secret-a. Root helper for provisioning/reading the credential directory.
#     Only root and gbsvc may invoke it (sudoers below). Every open by a
#     different UID is written to the audit log and refused. Source/destination
#     paths are confined to /tmp/gb-secret-* so a caller cannot use the helper
#     as a generic root file-write primitive.
install -d -m 0755 /usr/local/libexec /etc/sudoers.d
cat >/usr/local/libexec/gb-secrets <<'EOF'
#!/bin/bash
# General Bots OS secret-store helper (#2498).
# Actions: store <name> <source> | read <name> <dest> | remove <name>
set -euo pipefail

STORE=/etc/generalbots/credentials
SERVICE_UID="$(id -u gbsvc)"

fail() { echo "gb-secrets: $*" >&2; exit 2; }

valid_name() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
        .*) return 1 ;;
    esac
    return 0
}

valid_tmp_path() {
    case "$1" in
        /tmp/gb-secret-*) return 0 ;;
        *) return 1 ;;
    esac
}

# An open by anything other than the sidecar or root is audited and refused.
authorize() {
    local caller="${SUDO_UID:-$(id -u)}"
    if [ "$caller" != "$SERVICE_UID" ] && [ "$caller" != "0" ]; then
        logger -t gb-secrets -p authpriv.warn \
            "denied secret store open by uid $caller (sidecar uid $SERVICE_UID)"
        fail "access denied"
    fi
}

action="${1:-}"
name="${2:-}"
valid_name "$name" || fail "invalid secret name"

case "$action" in
    store)
        source="${3:-}"
        valid_tmp_path "$source" || fail "source must be under /tmp/gb-secret-*"
        [ -f "$source" ] || fail "missing source file"
        authorize
        install -m 0640 -o root -g gbsvc -- "$source" "$STORE/$name"
        rm -f -- "$source"
        logger -t gb-secrets -p authpriv.info "stored secret $name"
        ;;
    read)
        dest="${3:-}"
        valid_tmp_path "$dest" || fail "destination must be under /tmp/gb-secret-*"
        authorize
        [ -f "$STORE/$name" ] || fail "no such secret"
        # Never use --preserve=ownership: the secret is copied, not handed out.
        install -m 0600 -- "$STORE/$name" "$dest"
        chown "${SUDO_UID:-0}:${SUDO_GID:-0}" -- "$dest"
        logger -t gb-secrets -p authpriv.info "read secret $name"
        ;;
    remove)
        authorize
        rm -f -- "$STORE/$name"
        logger -t gb-secrets -p authpriv.info "removed secret $name"
        ;;
    *)
        fail "unknown action"
        ;;
esac
EOF
chmod 0750 /usr/local/libexec/gb-secrets
chown root:gbsvc /usr/local/libexec/gb-secrets

cat >/etc/sudoers.d/gb-secrets <<'EOF'
# General Bots OS (#2498) — only the sidecar account may reach the root-owned
# secret helper. The kiosk webview user is deliberately NOT listed here.
gbsvc ALL=(root) NOPASSWD: /usr/local/libexec/gb-secrets
EOF
chmod 0440 /etc/sudoers.d/gb-secrets

# 5-secret-b. #2498 — no plaintext login factor ships on the appliance. The
#     admin credential lives in Zitadel; the lock screen verifies against it.
#     Remove any legacy file from an older payload so the kiosk user cannot
#     read it. The writer itself is being removed in the same change set.
find /opt/general-bots /var/lib/gbdesk -name 'admin-credentials.json' -type f -delete 2>/dev/null || true

# 5-secret-c. #2498 — build gate: no generated stack artifact may contain a
#     plaintext Vault token or unseal key literal.
for artifact in /opt/general-bots/.env /opt/general-bots/conf/vault/init.json \
                /var/lib/gbdesk/.env /var/lib/gbdesk/conf/vault/init.json; do
    if [ -f "$artifact" ] && grep -Eq 'VAULT_TOKEN=|root_token|VAULT_UNSEAL_KEY_[0-9]+=' "$artifact"; then
        echo "ERROR: plaintext Vault secret found in $artifact (#2498)" >&2
        exit 1
    fi
done

# 5b. No first-boot wizard: on an appliance it blocks the console waiting
#     for locale/keymap/root input before the kiosk shell can start (seen in
#     the QEMU boot smoke: systemd-firstboot.service held serial input).
systemctl mask systemd-firstboot.service
printf 'general-bots-os\n' >/etc/hostname

# 5a. #2449 — session entry point. Wait for the user manager's bus, then exec
#     cage with the launcher. The fallback keeps the kiosk bootable if the
#     user manager is slow or absent (a private bus still lets GTK start).
cat >/usr/local/bin/gb-session <<'EOF'
#!/bin/sh
# General Bots OS session entry point (#2449).
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
bus="$XDG_RUNTIME_DIR/bus"
tries=0
while [ ! -S "$bus" ] && [ "$tries" -lt 40 ]; do
    tries=$((tries + 1))
    sleep 0.5
done
if [ -S "$bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
    exec /usr/bin/cage /opt/general-bots/start.sh
fi
echo "gb-session: user bus never appeared, falling back to a private session" >&2
exec /usr/bin/dbus-run-session -- /usr/bin/cage /opt/general-bots/start.sh
EOF
chmod 0755 /usr/local/bin/gb-session

# 5a-bis. #2455/#2449 — per-user services the kiosk relies on are enabled for
#     every user through default.target.wants, so PipeWire, the portals or gvfs
#     do not need to be spawned by hand from start.sh. A unit missing in this
#     base image is skipped instead of failing the build.
for unit in pipewire.socket pipewire-pulse.socket wireplumber.service \
            xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
            xdg-desktop-portal-wlr.service gvfs-daemon.service; do
    if [ -f "/usr/lib/systemd/user/$unit" ]; then
        install -d -m 0755 /etc/systemd/user/default.target.wants
        ln -sf "/usr/lib/systemd/user/$unit" "/etc/systemd/user/default.target.wants/$unit"
    fi
done

# 5c. #2458 — locale and keymap ship as data, not as a hard C.UTF-8 lock:
#     Settings → Time & Language rewrites these files through localectl, so
#     a Brazilian or Japanese laptop is not stuck on a US keyboard.
cat >/etc/locale.gen <<'EOF'
C.UTF-8 UTF-8
en_US.UTF-8 UTF-8
EOF
locale-gen
printf 'LANG=C.UTF-8\n' >/etc/locale.conf
cat >/etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="us"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF
printf 'KEYMAP=us\n' >/etc/vconsole.conf
# The clock defaults to UTC; the setup wizard / Settings pick a real zone and
# localectl writes it here. A wrong clock is a TLS and OTP failure, so the
# timezone file must exist even before the user chooses.
printf 'UTC\n' >/etc/timezone
ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# 6. Brand the OS identity everywhere an OS screen reads it: boot tools,
#    `hostnamectl`, the Plymouth theme selector and desktop icon lookups.
#    #2443 (offline slice): carry image version/channel/build metadata in
#    /etc/os-release when provided by the build environment; Settings → About
#    and update-channel UI/runtime wiring remain follow-up work.
GB_OS_VERSION="${GB_OS_VERSION:-${GB_DESKTOP_VERSION:-1}}"
GB_OS_CHANNEL="${GB_OS_CHANNEL:-stable}"
GB_OS_BUILD_DATE="${GB_OS_BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)}"
GB_OS_BUILD_ID="${GB_OS_BUILD_ID:-${GB_BUILD_ID:-dev}}"
cat >/etc/os-release <<EOF
NAME="General Bots OS"
PRETTY_NAME="General Bots OS ${GB_OS_VERSION} (${GB_OS_CHANNEL}, Debian 13 base)"
ID=general-bots-os
ID_LIKE=debian
VERSION_ID="${GB_OS_VERSION}"
VERSION="${GB_OS_VERSION} (trixie)"
VERSION_CODENAME=trixie
BUILD_ID="${GB_OS_BUILD_ID}"
IMAGE_ID="generalbots-os"
IMAGE_VERSION="${GB_OS_VERSION}"
GB_UPDATE_CHANNEL="${GB_OS_CHANNEL}"
GB_BUILD_DATE="${GB_OS_BUILD_DATE}"
HOME_URL="https://generalbots.org"
DOCUMENTATION_URL="https://docs.generalbots.org"
SUPPORT_URL="https://github.com/generalbots/generalbots/issues"
LOGO=general-bots
EOF
ln -sf /etc/os-release /usr/lib/os-release

# 7. #2500 — WebKitGTK must never fall back to an unsandboxed web process.
#    WEBKIT_FORCE_SANDBOX makes a bwrap failure fatal and visible instead of
#    silently running page content as the user that owns the database.
install -d -m 0755 /etc/environment.d
cat >/etc/environment.d/50-general-bots.conf <<'EOF'
WEBKIT_FORCE_SANDBOX=1
LIBSEAT_BACKEND=logind
EOF

# 8. #2444 — the ACPI power key and the lid are logind's business by default,
#    and logind's default for the power key is an instant poweroff with no
#    confirmation. The kiosk owns power from the shell (menu → power API), so
#    the physical key is ignored here and the shell maps it when it can ask.
#    The lid suspends as on any laptop; resume re-locks (#2446).
install -d -m 0755 /etc/systemd/logind.conf.d
cat >/etc/systemd/logind.conf.d/50-general-bots-power.conf <<'EOF'
# General Bots OS (#2444/#2446) — power actions are explicit.
# The power key no longer kills the machine: the shell shows its power menu
# (or the lock screen) and the user confirms. A long press is the firmware's
# business (hard power-off) and cannot be intercepted here.
HandlePowerKey=ignore
HandlePowerKeyLongPress=poweroff
HandleSuspendKey=ignore
HandleHibernateKey=ignore
HandleLidSwitch=suspend
HandleLidSwitchExternalPower=suspend
HandleLidSwitchDocked=ignore
# Resume must return to an authenticated screen, not to the session.
LidSwitchIgnoreInhibited=no
EOF

# 9. #2502 — the session bus is not a power API. Page script (or any app the
#    webview renders) must not be able to call logind's PowerOff/Reboot/
#    Suspend, change the network, or open a screencast. Denied here for the
#    kiosk user; the only path is the audited power endpoint in botserver.
install -d -m 0755 /etc/polkit-1/rules.d
cat >/etc/polkit-1/rules.d/50-general-bots-kiosk.rules <<'EOF'
// General Bots OS (#2502) — the kiosk user is not allowed to drive logind or
// NetworkManager directly. Power and network changes go through the shell's
// audited API (admin + loopback), which calls the root helper below.
polkit.addRule(function (action, subject) {
    var denied = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions",
        "org.freedesktop.login1.hibernate",
        "org.freedesktop.login1.hibernate-multiple-sessions",
        "org.freedesktop.login1.set-wall-message",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own"
    ];
    if (subject.user === "gbdesk" && denied.indexOf(action.id) !== -1) {
        return polkit.Result.NO;
    }
});
EOF

# 9b. The one privileged operation the shell needs is power, and it runs
#     through a root-owned helper with a fixed action whitelist — never a
#     generic `systemctl` grant, which would hand back everything the polkit
#     rule above just denied.
install -d -m 0755 /usr/local/libexec /etc/sudoers.d
cat >/usr/local/libexec/gb-power <<'EOF'
#!/bin/sh
# General Bots OS power helper (#2444). Fixed action list, no arguments pass
# through to another program, no shell expansion.
set -eu
action="${1:-}"
case "$action" in
    poweroff) exec /usr/bin/systemctl poweroff --no-block ;;
    reboot)   exec /usr/bin/systemctl reboot --no-block ;;
    suspend)  exec /usr/bin/systemctl suspend --no-block ;;
    signout)  exec /usr/bin/loginctl terminate-user gbdesk ;;
    *)        echo "gb-power: unknown action" >&2; exit 2 ;;
esac
EOF
chmod 0755 /usr/local/libexec/gb-power
cat >/etc/sudoers.d/gb-power <<'EOF'
# General Bots OS (#2444) — the kiosk user may call exactly one helper, and
# only for the four documented actions.
gbdesk ALL=(root) NOPASSWD: /usr/local/libexec/gb-power poweroff, \
    /usr/local/libexec/gb-power reboot, \
    /usr/local/libexec/gb-power suspend, \
    /usr/local/libexec/gb-power signout
EOF
chmod 0440 /etc/sudoers.d/gb-power

# 10. #2477 — a laptop joins untrusted networks. Default-deny inbound; the
#     whole provisioned stack (botserver, Vault, PostgreSQL, Valkey, MinIO,
#     Qdrant, Zitadel) listens on loopback only, so nothing on the café Wi-Fi
#     can reach the login form or the API. Outbound is unrestricted (the
#     setup wizard, model downloads and normal browsing need it), and the
#     documented opt-in to expose the suite is `GB_ALLOW_LAN=1`, which flips
#     botserver's bind address and adds an nftables rule.
install -d -m 0755 /etc/nftables.d
cat >/etc/nftables.conf <<'EOF'
#!/usr/sbin/nft -f
# General Bots OS (#2477) — a laptop is a machine that joins café Wi-Fi.
# Nothing listens on the LAN by default. Explicitly allowed: established and
# related traffic, loopback, DHCP and IPv6 neighbour discovery.
flush ruleset

table inet gb_filter {
    # Empty by default: no address may reach the suite ports until the user
    # turns on "Allow other devices on my network" in Settings → Network.
    set gb_lan_allowed {
        type ipv4_addr
        flags interval
        elements = { }
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        # DHCP client / server replies, mDNS-free by design.
        udp sport 67 udp dport 68 accept
        # IPv6 neighbour discovery and router advertisement.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit } accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
        # Administrative ICMP for diagnostics (ping from the machine itself).
        icmp type echo-request limit rate 5/second accept

        # Opt-in LAN exposure (#2477): the shell adds addresses to this set
        # when the user turns on "Allow other devices on my network".
        ip saddr @gb_lan_allowed tcp dport { 8080, 3000, 4000, 5000 } accept
        log prefix "gb-input-drop: " level warn limit rate 5/minute
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
EOF
chmod 0755 /etc/nftables.conf

# 10. #2460 — removable media automount for the kiosk user. udisks2 mounts
#     USB sticks, SD cards and external SSDs under /media/gbdesk/<label>,
#     read/write for exFAT/FAT32/ext4 and read-only for NTFS.
install -d -m 0755 /etc/udev/rules.d
cat >/etc/udev/rules.d/60-gb-removable-automount.rules <<'UDEVRULES'
# Automount removable block devices for the kiosk session.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_DRIVE_FLASH}=="1", ENV{UDISKS_AUTO}="1", ENV{UDISKS_AUTOMOUNT_HINT}="always"
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{UDISKS_AUTO}="1", ENV{UDISKS_AUTOMOUNT_HINT}="always"
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="sdio", ENV{UDISKS_AUTO}="1", ENV{UDISKS_AUTOMOUNT_HINT}="always"
UDEVRULES
install -d -m 0755 /etc/udisks2
cat >/etc/udisks2/udisks2.conf <<'UDISKSCONF'
[udisks2]
modules=
[mounts]
automount=true
UDISKSCONF
install -d -m 0755 /media/gbdesk
chmod 0755 /media/gbdesk

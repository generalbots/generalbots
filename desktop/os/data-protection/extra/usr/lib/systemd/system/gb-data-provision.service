[Unit]
Description=General Bots OS - provision and unlock encrypted user data (#2470)
Documentation=man:cryptsetup(8) man:btrfs(8)
# Must run before the kiosk shell writes into /var/lib/gbdesk.
Before=generalbots-shell.service
After=local-fs.target
ConditionPathExists=/usr/local/libexec/gb-data/provision.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /usr/local/libexec/gb-data/provision.sh --boot
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
